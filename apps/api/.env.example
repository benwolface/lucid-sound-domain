NODE_ENV=development
API_PORT=8787

# Used for CORS in local dev (optional if frontend uses Vite proxy)
WEB_ORIGIN="http://localhost:5173"

# How long the session lasts (in days). Auth cookie uses this by default.
SESSION_DAYS=30

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Admin API — protect /api/admin/* routes with this secret
# Pass as header: x-admin-secret: <value>
ADMIN_SECRET=

# Returned only after a valid referral/session code hits /api/settings/private.
# Keep the exact event address out of committed frontend source.
PORTAL_LOCATION_PRIVATE=
